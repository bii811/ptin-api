meta {
  name: change-password-wrong-current
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  { "currentPassword": "definitely-wrong", "newPassword": "BrandNew123x" }
}

tests {
  test("change password wrong current", function () {
    expect(res.status).to.equal(401);
  });
}
