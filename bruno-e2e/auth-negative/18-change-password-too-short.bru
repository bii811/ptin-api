meta {
  name: change-password-too-short
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  { "currentPassword": "{{userPassword}}", "newPassword": "short" }
}

tests {
  test("change password too short", function () {
    expect(res.status).to.equal(400);
  });
}
