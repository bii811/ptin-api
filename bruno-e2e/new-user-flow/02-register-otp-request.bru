meta {
  name: register-otp-request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register/otp/request
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}" }
}

script:post-response {
  // needs otp.expose-in-response=true (local/uat); never run against prod
  const m = (res.body.message || "").match(/OTP: (\d+)/);
  if (m) bru.setVar("otpCode", m[1]);
}

tests {
  test("otp issued and echoed", function () {
    expect(res.status).to.equal(200);
    expect(bru.getVar("otpCode"), "OTP not in response message - is otp.expose-in-response on?").to.be.a("string");
  });
}
