meta {
  name: profile-update-if-needed
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/profile/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  { "firstName": "E2e", "lastName": "Tester" }
}

script:pre-request {
  if (bru.getVar("profileComplete") === true) bru.runner.skipRequest();
}

tests {
  test("profile complete", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.complete).to.equal(true);
  });
}
