meta {
  name: login-admin
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "username": "{{adminUsername}}", "password": "{{adminPassword}}" }
}

script:post-response {
  if (res.status === 200) bru.setVar("adminToken", res.body.data.accessToken);
}

tests {
  test("logged in as staff", function () {
    expect(res.status).to.equal(200);
    expect(bru.getVar("adminToken")).to.be.a("string");
  });
}
