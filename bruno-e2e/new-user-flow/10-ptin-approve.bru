meta {
  name: ptin-approve
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/ptin/applications/{{applicationId}}/approve
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

script:post-response {
  if (res.status === 200) bru.setVar("tin", res.body.data.tin);
}

tests {
  // approve blocks on TaxRIS and returns 200 even when issuance fails, so check status, not just HTTP
  test("approved and TIN issued by TaxRIS", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status, res.body.data.failureReason).to.equal("ISSUED");
    expect(res.body.data.tin).to.be.a("string").and.not.empty;
  });
}
