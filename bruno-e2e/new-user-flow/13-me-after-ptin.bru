meta {
  name: me-after-ptin
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("/auth/me exposes the issued TIN", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.tin).to.be.a("string").and.not.empty;
    expect(res.body.data.tin).to.equal(bru.getVar("tin"));
  });
}
