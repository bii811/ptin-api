meta {
  name: declare-ok
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  {
    "invoiceNumber": "{{okInvoice}}",
    "invoiceDate": "20260101",
    "saleCount": "1",
    "supplyAmount": "100",
    "vatAmount": "10",
    "saleAmount": "110",
    "items": [
      {
        "hsCode": "8517",
        "hsName": "Telephone sets",
        "saleCount": "1",
        "unitSale": "EA",
        "unitSaleAmount": "100",
        "supplyAmount": "100",
        "exciseAmount": "0",
        "vatAmount": "10",
        "saleAmount": "110"
      }
    ]
  }
}

script:pre-request {
  bru.setVar("okInvoice", "E2E-OK-" + String(Math.floor(Math.random() * 1e8)).padStart(8, "0"));
}

tests {
  test("accepted declaration is SUBMITTED and not retryable", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal("SUBMITTED");
    expect(res.body.data.retryable).to.equal(false);
  });
}
