meta {
  name: retry-unknown
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations/{{hangDeclarationId}}/retry
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("retry of the UNKNOWN declaration succeeds", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("SUBMITTED");
    expect(res.body.data.retryCount).to.equal(1);
  });
}
