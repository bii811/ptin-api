meta {
  name: declare-duplicate-invoice
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  {
    "invoiceNumber": "{{okInvoice}}",
    "invoiceDate": "20260101",
    "saleCount": "1",
    "supplyAmount": "100",
    "vatAmount": "10",
    "saleAmount": "110",
    "items": [
      {
        "hsCode": "8517",
        "hsName": "Telephone sets",
        "saleCount": "1",
        "unitSale": "EA",
        "unitSaleAmount": "100",
        "supplyAmount": "100",
        "exciseAmount": "0",
        "vatAmount": "10",
        "saleAmount": "110"
      }
    ]
  }
}

tests {
  test("same invoice again while a live declaration exists is 409", function () {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
