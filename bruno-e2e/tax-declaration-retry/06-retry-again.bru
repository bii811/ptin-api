meta {
  name: retry-again
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations/{{declarationId}}/retry
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("a SUBMITTED declaration cannot be retried", function () {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
