meta {
  name: declare-timeout-unknown
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  {
    "invoiceNumber": "{{hangInvoice}}",
    "invoiceDate": "20260101",
    "saleCount": "1",
    "supplyAmount": "100",
    "vatAmount": "10",
    "saleAmount": "110",
    "items": [
      {
        "hsCode": "8517",
        "hsName": "Telephone sets",
        "saleCount": "1",
        "unitSale": "EA",
        "unitSaleAmount": "100",
        "supplyAmount": "100",
        "exciseAmount": "0",
        "vatAmount": "10",
        "saleAmount": "110"
      }
    ]
  }
}

script:pre-request {
  bru.setVar("hangInvoice", "E2E-HANG-" + String(Math.floor(Math.random() * 1e8)).padStart(8, "0"));
}

script:post-response {
  if (res.status === 201) bru.setVar("hangDeclarationId", res.body.data.id);
}

tests {
  test("no reply from TaxRIS is UNKNOWN (it may have been recorded), not FAILED", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal("UNKNOWN");
    expect(res.body.data.retryable).to.equal(true);
  });
}
