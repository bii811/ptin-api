meta {
  name: login-with-temp-password-again
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "{{temporaryPassword}}" }
}

tests {
  test("temporary password no longer works", function () {
    expect(res.status).to.equal(401);
  });
}
