meta {
  name: temp-password-no-token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/users/temporary-password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}" }
}

tests {
  test("temp password no token", function () {
    expect(res.status).to.equal(401);
  });
}
