meta {
  name: temp-password-issue
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/users/temporary-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  { "mobileNumber": "{{mobileNumber}}" }
}

script:post-response {
  if (res.status === 200) bru.setVar("temporaryPassword", res.body.data.temporaryPassword);
}

tests {
  test("temp password issue", function () {
    expect(res.status).to.equal(200);
    expect(bru.getVar("temporaryPassword")).to.be.a("string").and.have.lengthOf(12);
  });
}
