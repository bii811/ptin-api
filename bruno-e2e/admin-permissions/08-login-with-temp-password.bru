meta {
  name: login-with-temp-password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "{{temporaryPassword}}" }
}

script:post-response {
  if (res.status === 200) bru.setVar("resetToken", res.body.data.resetToken);
}

tests {
  test("temporary password yields a reset token, not a session", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.passwordChangeRequired).to.equal(true);
    expect(res.body.data.resetToken).to.be.a("string");
    expect(res.body.data.accessToken || null).to.equal(null);
  });
}
