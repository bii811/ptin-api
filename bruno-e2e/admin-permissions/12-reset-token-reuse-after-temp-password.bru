meta {
  name: reset-token-reuse-after-temp-password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password/reset
  body: json
  auth: none
}

body:json {
  { "resetToken": "{{resetToken}}", "newPassword": "AnotherPass123x" }
}

tests {
  test("the reset token is spent once the password changed, even within the same second", function () {
    expect(res.status).to.equal(401);
  });
}
