meta {
  name: login-with-chosen-password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "ChosenPass123x" }
}

tests {
  test("login with chosen password", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.accessToken).to.be.a("string");
  });
}
