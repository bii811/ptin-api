meta {
  name: login-old-password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "{{userPassword}}" }
}

tests {
  test("old password rejected after reset", function () {
    expect(res.status).to.equal(401);
  });
}
