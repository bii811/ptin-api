meta {
  name: login-wrong-password-5-locks
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "definitely-wrong" }
}

tests {
  test("5th failure locks the account", function () {
    expect(res.status).to.equal(423);
  });
}
