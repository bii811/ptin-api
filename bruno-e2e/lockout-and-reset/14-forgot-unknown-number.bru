meta {
  name: forgot-unknown-number
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password/otp/request
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "2099999999" }
}

tests {
  test("unknown number gets the generic success (no account enumeration)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
