meta {
  name: login-new-password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "NewPass123x" }
}

tests {
  test("reset cleared the lockout and the new password works", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.accessToken).to.be.a("string");
  });
}
