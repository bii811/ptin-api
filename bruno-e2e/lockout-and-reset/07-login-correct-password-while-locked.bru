meta {
  name: login-correct-password-while-locked
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login/password
  body: json
  auth: none
}

body:json {
  { "mobileNumber": "{{mobileNumber}}", "password": "{{userPassword}}" }
}

tests {
  test("login correct password while locked", function () {
    expect(res.status).to.equal(423);
  });
}
