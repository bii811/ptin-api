meta {
  name: submit-ok
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/ptin/applications
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  {
    "ptinType": "INDIVIDUAL",
    "givenName": "E2e",
    "familyName": "Tester",
    "gender": "M",
    "nationality": "LA",
    "birthDay": "19900101",
    "hpNo": "0{{mobileNumber}}",
    "email": "e2e@example.com",
    "pubOffiYn": "N",
    "indBusnOprYn": "N",
    "pvtCoEmpYn": "N",
    "divdIncYn": "N",
    "rentIncYn": "N"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("applicationId", res.body.data.id);
}

tests {
  test("submit ok", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal("PENDING_APPROVAL");
  });
}
