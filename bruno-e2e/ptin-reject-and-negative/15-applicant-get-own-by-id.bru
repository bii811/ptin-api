meta {
  name: applicant-get-own-by-id
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/ptin/applications/{{applicationId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("applicant get own by id", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("applicationId"));
  });
}
