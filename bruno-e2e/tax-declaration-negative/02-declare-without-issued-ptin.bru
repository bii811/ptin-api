meta {
  name: declare-without-issued-ptin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/tax-declarations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

body:json {
  {
