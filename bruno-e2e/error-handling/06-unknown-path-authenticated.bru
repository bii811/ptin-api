meta {
  name: unknown-path-authenticated
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/does-not-exist
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{userToken}}
}

tests {
  test("unknown path authenticated", function () {
    expect(res.status).to.equal(404);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
