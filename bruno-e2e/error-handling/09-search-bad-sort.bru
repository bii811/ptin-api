meta {
  name: search-bad-sort
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/ptin/applications/search?sort=bogus,asc
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("unknown sort property is 400, not 500/401", function () {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
