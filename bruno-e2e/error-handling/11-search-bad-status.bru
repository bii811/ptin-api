meta {
  name: search-bad-status
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/ptin/applications/search?status=BOGUS
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("search bad status", function () {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
