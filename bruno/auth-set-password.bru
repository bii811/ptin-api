meta {
  name: auth-set-password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}"
  }
}

assert {
  res.status: eq 200
}
