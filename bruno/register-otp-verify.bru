meta {
  name: register-otp-verify
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/register/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "mobileNumber": "{{mobileNumber}}",
    "otpCode": "{{otpCode}}"
  }
}

script:post-response {
  bru.setVar("registrationToken", res.body.data.token);
}

assert {
  res.status: eq 200
}
