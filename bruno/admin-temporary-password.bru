meta {
  name: admin-temporary-password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/admin/users/temporary-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "mobileNumber": "{{mobileNumber}}"
  }
}

assert {
  res.status: eq 200
}
