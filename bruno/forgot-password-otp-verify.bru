meta {
  name: forgot-password-otp-verify
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "mobileNumber": "{{mobileNumber}}",
    "otpCode": "{{otpCode}}"
  }
}

script:post-response {
  bru.setVar("resetToken", res.body.data.token);
}

assert {
  res.status: eq 200
}
