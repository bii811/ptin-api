meta {
  name: profile-update-user
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/api/v1/profile/users/{{userId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "firstName": "Somsy",
    "lastName": "Vongphachan",
    "avatarUrl": "https://example.com/avatar.png"
  }
}

assert {
  res.status: eq 200
}
